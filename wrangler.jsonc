{
  "name": "script-uploader",
  "main": "src/index.js",
  "compatibility_date": "2025-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "PUBLIC_BASE_URL": "https://script-uploader.YOUR-SUBDOMAIN.workers.dev",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scripts-platform",
      "database_id": "PASTE_YOUR_D1_ID_HERE"
    }
  ]
}